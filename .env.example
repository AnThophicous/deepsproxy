# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger endpoints (opcional)
API_KEY=sua-chave-secreta-aqui

# Configuracoes Playwright usadas por npm run login
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
DEEPSPROXY_CHAT_INPUT_TIMEOUT_MS=8000

# Deixe true quando o cliente/agente ja envia as proprias tools e system prompt.
DEEPSPROXY_DISABLE_TOOL_PROMPT=false

# Mantem desligado para evitar que texto natural vire chamada de ferramenta incompleta.
DEEPSPROXY_ENABLE_NATURAL_TOOL_INFERENCE=false

# Store local da Responses API. Mantem previous_response_id funcionando entre restarts.
DEEPSPROXY_RESPONSES_STORE_PATH=.deepsproxy/responses-store.json
DEEPSPROXY_RESPONSES_TTL_MS=604800000
DEEPSPROXY_RESPONSES_MAX_ENTRIES=1000

# Por padrao a API nao abre Playwright em runtime. Use npm run login para gerar cache.
DEEPSPROXY_ALLOW_RUNTIME_BROWSER=false

# PoW por request. Normalmente nao precisa mexer.
DEEPSPROXY_POW_WASM_URL=https://fe-static.deepseek.com/chat/static/sha3_wasm_bg.7b9ca65ddd.wasm
DEEPSPROXY_POW_MAX_DIFFICULTY=20000000

# Use true apenas se voce nao quiser que npm install baixe o Chromium do Playwright.
DEEPSPROXY_SKIP_BROWSER_INSTALL=false

# Logging
LOG_LEVEL=info
